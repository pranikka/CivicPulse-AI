# CivicPulse AI Environment Variables

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=0
# Set to 1 only when serving over HTTPS.
SESSION_COOKIE_SECURE=0
SECRET_KEY=generate-a-long-random-secret-here

# Database
DATABASE_URL=sqlite:///civicpulse.db

# Features (optional)
ENABLE_VOICE_INPUT=false
ENABLE_ADVANCED_AI=false

# Smart AI complaint analysis
# local = safe built-in analyzer; openai = optional external provider
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional custom secure upload directory
# CIVICPULSE_UPLOAD_FOLDER=

# Optional email notifications
# The app works normally when these are missing or disabled.
EMAIL_NOTIFICATIONS_ENABLED=0
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1
EMAIL_SUBJECT_PREFIX=[CivicPulse AI]
